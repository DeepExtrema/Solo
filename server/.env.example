# Copy this file to server/.env and fill in real values.
# server/.env is gitignored — never commit secrets.

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
# Use a SECRET key (sb_secret_...) for server-side — it bypasses RLS.
# The publishable key (sb_publishable_...) is for the browser only.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Single-user default; leave as 'solo' unless you know you need multiple.
HUNTER_ID=solo

# Express
PORT=3001
