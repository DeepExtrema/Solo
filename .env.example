# Parallax Gate — environment variables
# Copy this file to .env and fill in your values

# Fitbit OAuth — register a Personal app at https://dev.fitbit.com/apps/new
# Redirect URI must match exactly: http://localhost:3001/fitbit/callback
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=http://localhost:3001/fitbit/callback

# LeetCode username — used against alfa-leetcode-api (no auth required)
LEETCODE_USERNAME=

# Server
PORT=3001
